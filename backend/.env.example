# MandiMate API configuration. Copy to backend/.env and adjust; real environment variables
# take precedence over this file. Every variable is optional and shown with its default.

# ── Application ───────────────────────────────────────────────────────────────────────────
# development | test | staging | production. Production refuses to start with the default
# JWT_SECRET and adds HSTS.
APP_ENV=development
APP_NAME=MandiMate
APP_VERSION=0.1.0
API_PREFIX=/api/v1
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Database (PostgreSQL 17, asyncpg driver) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mandimate:mandimate@localhost:5432/mandimate
# Used only by the pytest suite; it is dropped and recreated on every run.
TEST_DATABASE_URL=postgresql+asyncpg://mandimate:mandimate@localhost:5432/mandimate_test
# Log every SQL statement.
DB_ECHO=false

# ── Auth ──────────────────────────────────────────────────────────────────────────────
# HMAC signing key for JWTs. Production requires a unique random value of 32+ characters,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=mandimate-development-secret-change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Set to true whenever the site is served over HTTPS (always in production).
COOKIE_SECURE=false
# Leave empty for host-only cookies.
COOKIE_DOMAIN=
# Browser origins allowed to call the API with credentials (comma-separated or JSON array).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ── Uploads ───────────────────────────────────────────────────────────────────────────
# Directory for uploaded harvest photos (relative paths are resolved against backend/).
MEDIA_DIR=media
# URL path the API serves MEDIA_DIR under.
MEDIA_URL=/media
MAX_UPLOAD_MB=8

# ── AI (DeepSeek) ─────────────────────────────────────────────────────────────────────
# auto: live when DEEPSEEK_API_KEY is set, otherwise deterministic rule-based responses.
# live: use DeepSeek (still falls back to rules on errors). mock: never call an LLM.
AI_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30

# ── Public site ───────────────────────────────────────────────────────────────────────
# Canonical URL of the web app (used in links the API generates).
SITE_URL=http://localhost:5173
